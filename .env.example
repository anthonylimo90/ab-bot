# AB-Bot / Polymarket Scanner Configuration
# Copy this file to .env and fill in your values

# ===================
# Environment
# ===================
# Options: development | staging | production
ENVIRONMENT=development

# ===================
# Docker Configuration
# ===================
POSTGRES_USER=abbot
POSTGRES_PASSWORD=abbot_secret
POSTGRES_DB=ab_bot
POSTGRES_PORT=5432

# Redis is not exposed to host by default in docker-compose (network-isolated).
# If you need host access for debugging, use: docker compose exec redis redis-cli ...
REDIS_PORT=6379
REDIS_APP_PASSWORD=app_secret_change_me
REDIS_DYNAMIC_TUNER_PASSWORD=dynamic_tuner_secret_change_me
REDIS_DYNAMIC_SUBSCRIBER_PASSWORD=dynamic_subscriber_secret_change_me

# ===================
# Database (Required)
# ===================
# For Docker: postgres://abbot:abbot_secret@postgres:5432/ab_bot
# For local: postgres://user:password@localhost:5432/ab_bot
DATABASE_URL=postgres://abbot:abbot_secret@localhost:5432/ab_bot
DATABASE_MAX_CONNECTIONS=20

# ===================
# Redis (Required)
# ===================
# For Docker (ACL app user): redis://app:<password>@redis:6379
# For local (ACL app user): redis://app:<password>@127.0.0.1:6379
REDIS_URL=redis://app:app_secret_change_me@127.0.0.1:6379
# Dynamic tuner publish/read connection (sole writer for dynamic:config:update)
DYNAMIC_TUNER_REDIS_URL=redis://dynamic_tuner:dynamic_tuner_secret_change_me@127.0.0.1:6379
# Dynamic config subscriber connection (read-only pub/sub consumer)
DYNAMIC_CONFIG_REDIS_URL=redis://dynamic_subscriber:dynamic_subscriber_secret_change_me@127.0.0.1:6379

# ===================
# Polygon RPC (Required - choose one)
# ===================
# Option 1: Alchemy (recommended)
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Option 2: Direct RPC URL
# POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your_key

# ===================
# Polymarket API (Optional - uses defaults)
# ===================
# POLYMARKET_CLOB_URL=https://clob.polymarket.com
# POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# ===================
# Alerts (Optional)
# ===================
# Telegram
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# Discord
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ===================
# API Server
# ===================
API_HOST=0.0.0.0
API_PORT=3000

# JWT_SECRET is REQUIRED and must be:
# - At least 32 characters long
# - A secure random value: placeholders (including the old example value) and
#   secrets with fewer than 10 distinct characters are refused at startup unless
#   ENVIRONMENT=development, where they only log a warning
# Generate one and paste it below:  openssl rand -base64 32
JWT_SECRET=

CORS_PERMISSIVE=true
# Comma-separated exact origins allowed to call the API from a browser, e.g.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# When set it takes precedence over CORS_PERMISSIVE (methods GET/POST/PUT/PATCH/
# DELETE/OPTIONS, headers Authorization/Content-Type). When unset every origin is
# still allowed, CORS_PERMISSIVE=false included (a startup warning is logged), so
# set it in staging/production.
# CORS_ALLOWED_ORIGINS=
WS_CHANNEL_CAPACITY=1000

# Sign-In with Ethereum (wallet login). Every sign-in message must name exactly
# this site and chain 137 (Polygon); messages issued for any other domain/URI are
# rejected with 401. Set both to your public dashboard values in production:
# outside development, wallet sign-in is disabled until both are set.
# APP_DOMAIN=localhost                 # host[:port] shown in the wallet prompt, e.g. app.example.com
# APP_URI=http://localhost:3002        # site origin, e.g. https://app.example.com

# Number of trusted reverse proxies in front of the API (Railway, nginx, ...).
# Rate limiting identifies a client by the X-Forwarded-For entry that many places
# from the RIGHT (the one your own proxy appended); entries further left are
# client-controlled and ignored. 1 = a single proxy (default). Set 0 when the API
# is exposed directly (X-Forwarded-For is then ignored and the TCP peer is used).
TRUSTED_PROXY_HOPS=1

# Maximum concurrent Argon2 password hash/verify operations (each uses ~19 MiB
# and a CPU core). Excess logins wait up to 10s, then get 503. Default 4.
# ARGON2_MAX_CONCURRENCY=4

# ===================
# Arb Monitor
# ===================
# Arb execution toggles
ARB_AUTO_EXECUTE=false
ARB_POSITION_SIZE=50
ARB_MIN_NET_PROFIT=0.001
ARB_MIN_BOOK_DEPTH=100
ARB_MONITOR_MIN_BOOK_DEPTH=100        # Defaults to ARB_MIN_BOOK_DEPTH when unset
ARB_MAX_SIGNAL_AGE_SECS=30
ARB_CACHE_REFRESH_SECS=300
ARB_MIN_PROFIT_THRESHOLD=0.005
ARB_MONITOR_MAX_MARKETS=300
GAMMA_ARB_MARKET_PAGE_SIZE=200       # Gamma page size for tradable market discovery
CLOB_MARKET_LIMIT=200000             # Market cache pagination limit
# stable | balanced | discovery
ARB_MONITOR_AGGRESSIVENESS=balanced
ARB_MONITOR_EXPLORATION_SLOTS=5
ARB_SELECTION_RESUBSCRIBE_MIN_MARKET_DELTA=8
ARB_SELECTION_RESUBSCRIBE_MIN_DELTA_RATIO=0.08
ARB_SELECTION_FORCE_REFRESH_SECS=600
ARB_EXPLORATION_HOLD_SECS=600
ARB_EXPLORATION_SWAP_MIN_SCORE_DELTA=0.75
ARB_UPDATE_TIMEOUT_SECS=120

# ===================
# Gamma Syncer (Market Metadata)
# ===================
GAMMA_SYNCER_ENABLED=true
GAMMA_SYNCER_INTERVAL_SECS=3600

# ===================
# Flow Feature Calculator
# ===================
FLOW_FEATURE_ENABLED=true
FLOW_FEATURE_INTERVAL_SECS=300
SMART_MONEY_BOT_THRESHOLD=30

# ===================
# Quant Signal System
# ===================
QUANT_EXECUTOR_ENABLED=false           # Paper-first (signals logged, not executed)
QUANT_BASE_POSITION_SIZE=30            # Base size in USD (before confidence weighting)
QUANT_MIN_CONFIDENCE=0.65              # Minimum confidence to execute (0.0–1.0)
QUANT_MAX_POSITIONS=20                 # Max simultaneous quant positions
QUANT_MAX_SIGNAL_AGE_SECS=120          # Max signal age before discarding
QUANT_MIN_BOOK_DEPTH=50                # Minimum orderbook depth in USD

# Signal Generator Toggles
FLOW_SIGNAL_ENABLED=true
FLOW_SIGNAL_INTERVAL_SECS=300
FLOW_MIN_IMBALANCE=0.25
FLOW_MIN_SMART_MONEY_USD=500
FLOW_MIN_TRADE_COUNT=5
# Flow signals trade live only once 8 flow trades from the last 14 days have
# closed; until then they are emitted for paper trading (executor enabled,
# live trading off), which builds that calibration. false skips calibration.
FLOW_REQUIRE_CALIBRATION=true
FLOW_CALIBRATION_MIN_CLOSED_TRADES=8
FLOW_CALIBRATION_LOOKBACK_DAYS=14
RESOLUTION_SIGNAL_ENABLED=true
RESOLUTION_SIGNAL_INTERVAL_SECS=900
MEAN_REVERSION_SIGNAL_ENABLED=true
MEAN_REVERSION_INTERVAL_SECS=600
MEAN_REV_MIN_MOVE_PCT=0.10
CROSS_MARKET_SIGNAL_ENABLED=false      # Enable in Phase 5

# Strategy Performance
STRATEGY_PNL_ENABLED=true
STRATEGY_PNL_INTERVAL_SECS=21600       # 6 hours
QUANT_STRATEGY_MAX_DAILY_LOSS=200      # Per-strategy daily loss limit
QUANT_STRATEGY_MAX_CONSECUTIVE_LOSSES=5

# ===================
# Live Trading
# ===================
LIVE_TRADING=false
EXECUTOR_MIN_BOOK_DEPTH=100
# Trading signer is selected at startup. Personal primary wallets never switch it.
# TRADING_WALLET_ADDRESS=0x...
# If an address is configured, this key must match it (or use its vault key).
# WALLET_PRIVATE_KEY=0x...

# Key vault for wallets connected through the dashboard. Keys are encrypted
# with VAULT_MASTER_KEY (a random secret, e.g. openssl rand -base64 32) and
# kept in VAULT_FILE_PATH (owner-only file, written atomically).
#   VAULT_PROVIDER=file   persistent (required to connect wallets in production)
#   unset                 read-only: keys only from WALLET_KEY_<ADDRESS> vars
# Without VAULT_MASTER_KEY, development keeps keys in memory (lost on restart)
# and every other environment refuses to store keys.
# VAULT_MASTER_KEY=
# VAULT_PROVIDER=file
# VAULT_FILE_PATH=./vault.enc

# ===================
# Dynamic Tuner
# ===================
DYNAMIC_TUNER_ENABLED=true
DYNAMIC_TUNER_APPLY=true
DYNAMIC_TUNER_INTERVAL_SECS=300
DYNAMIC_TUNER_REGIME_STREAK=2
DYNAMIC_TUNER_FREEZE_DRAWDOWN=0.20
DYNAMIC_TUNER_EVAL_DELAY_MINUTES=10
DYNAMIC_TUNER_FILL_DEGRADE_DELTA=0.08
DYNAMIC_TUNER_PNL_DEGRADE_DELTA=75
DYNAMIC_TUNER_BOOTSTRAP_ENABLED=true
DYNAMIC_TUNER_BOOTSTRAP_MAX_ATTEMPTS=100
DYNAMIC_TUNER_NO_TRADE_WINDOW_MINUTES=120
DYNAMIC_TUNER_NO_TRADE_MIN_ATTEMPTS=20
DYNAMIC_CONFIG_ALLOWED_SOURCES=dynamic_tuner,dynamic_tuner_rollback,dynamic_tuner_sync,workspace_manual

# ===================
# Monitoring (Optional)
# ===================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ===================
# Email (Optional - for password reset, sent through Resend)
# ===================
# RESEND_API_KEY=re_...
# RESEND_FROM=noreply@yourdomain.com
# RESEND_FROM_NAME=Polymarket Scanner
# APP_URL=https://your-dashboard-url.com

# ===================
# Logging
# ===================
RUST_LOG=api_server=info,arb_monitor=info,bot_scanner=info,polymarket_core=warn
